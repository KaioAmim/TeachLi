# Interface
VITE_APP_TITLE=TeachLi
VITE_APP_LOGO=

# Servidor independente da Sala de Aula (server/)
# Nunca exponha estes valores ao frontend nem faça commit de um .env real.
TEACHLI_CORS_ORIGIN=http://localhost:5173
# Defina 1 somente atras de proxy reverso que sobrescreve X-Forwarded-For (limite de tentativas por IP real).
# TEACHLI_TRUST_PROXY=1

# Frontend independente (client/). Estes valores são públicos no build.
VITE_SIGNALING_URL=ws://localhost:8787

# Login Microsoft para o frontend (valores públicos; nunca use client secret aqui).
VITE_MICROSOFT_CLIENT_ID=
# Obrigatório: GUID do tenant da instituição
VITE_MICROSOFT_TENANT_ID=
