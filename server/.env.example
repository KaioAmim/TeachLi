# Opcional: o servidor já reutiliza o Client ID público configurado no cliente.
# Em hospedagem separada, informe aqui o MESMO ID do aplicativo existente.
# MICROSOFT_CLIENT_ID=
# Obrigatório: GUID do tenant da instituição. O servidor aceita apenas tokens desse tenant.
# Reutiliza VITE_MICROSOFT_TENANT_ID do cliente quando não definido aqui.
# MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
# Defina 1 somente atras de proxy reverso que sobrescreve X-Forwarded-For.
# TEACHLI_TRUST_PROXY=1
TEACHLI_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=8787
# Opcional: catálogo JSON com IDs estáveis. O padrão inclui laboratórios A/B/C e salas 01/02.
# TEACHLI_ROOMS=[{"id":"laboratorio-c","name":"Laboratório C"}]
