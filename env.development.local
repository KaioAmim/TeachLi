# Variáveis de ambiente para o ambiente de desenvolvimento local

# A URL base para o servidor OAuth.
# Como você está rodando localmente, vamos usar o próprio localhost:3000
VITE_OAUTH_SERVER_URL=http://localhost:3000

# Variáveis que o Vite está reclamando, vamos defini-las como vazias para evitar erros
VITE_APP_LOGO=
VITE_APP_TITLE=Sistema de Interpretação de Libras
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
