# Copie para .env.docker e preencha antes de iniciar o Compose.
# Mesmo Application (client) ID público usado no login Microsoft já existente.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Chave longa e aleatória para proteger o proxy LiteLLM (deve começar com sk-).
LITELLM_MASTER_KEY=sk-substitua-por-uma-chave-segura

# Chaves dos provedores de plano gratuito usados no failover do LiteLLM.
# Nunca faça commit de valores reais nem cole chaves em chats ou tickets.
GROQ_API_KEY=gsk_substitua            # console.groq.com/keys
OPENROUTER_API_KEY=sk-or-v1-substitua # openrouter.ai/keys
GEMINI_API_KEY=substitua              # aistudio.google.com/apikey

# Para acesso local, mantenha os valores padrão. Em HTTPS, use wss:// e a URL pública.
VITE_SIGNALING_URL=ws://localhost:8787
TEACHLI_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
