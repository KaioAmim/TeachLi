FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN python -m venv /opt/litellm \
    && /opt/litellm/bin/pip install --no-cache-dir 'litellm[proxy]==1.111.0'

COPY server/litellm-config.example.yaml ./config.yaml

EXPOSE 4000

ENTRYPOINT ["/opt/litellm/bin/litellm"]
CMD ["--config", "/app/config.yaml", "--host", "0.0.0.0", "--port", "4000"]
