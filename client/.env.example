# Valores públicos do aplicativo Microsoft (nunca Client Secret). Copie para client/.env.local.
VITE_MICROSOFT_CLIENT_ID=
# Obrigatório: GUID do tenant da instituição (não use "organizations").
VITE_MICROSOFT_TENANT_ID=

# Opcional: servidor TURN institucional para redes que bloqueiam a conexao direta da chamada (valores ficam publicos no build; use credenciais temporarias).
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
