# Copie para .env.docker e preencha antes de iniciar o Compose.
# Mesmo Application (client) ID público usado no login Microsoft já existente.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Chave longa e aleatória para proteger o proxy LiteLLM.
LITELLM_MASTER_KEY=sk-substitua-por-uma-chave-segura

# Chaves dos provedores usadas pelo failover do LiteLLM
# (ordem: Groq, Cloudflare, OpenRouter, Mistral, Gemini). Todas têm plano gratuito.
# Ficam somente no container litellm. Não ative planos pagos nas contas para evitar cobrança.
GROQ_API_KEY=gsk_substitua-pela-chave-da-groq
# Cloudflare Workers AI: ID da conta (32 hex) e token com permissão "Workers AI".
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=substitua-pelo-token-da-cloudflare
OPENROUTER_API_KEY=sk-or-substitua-pela-chave-do-openrouter
# Mistral: exige o plano gratuito "Experiment" ativo no console; sem ele a API responde 402.
MINISTRAL_AI_API_KEY=substitua-pela-chave-da-mistral
GEMINI_API_KEY=substitua-pela-chave-do-gemini

# Para acesso local, mantenha os valores padrão. Em HTTPS, use wss:// e a URL pública.
VITE_SIGNALING_URL=ws://localhost:8787
TEACHLI_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
